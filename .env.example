# Public URL of the deployed site (used for Open Graph / share links).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# RSVP storage (optional). Leave unset for WhatsApp-only replies.
# One of: sheets | supabase
RSVP_ADAPTER=

# --- sheets: Google Apps Script web app URL (see README)
GOOGLE_SHEETS_WEBHOOK_URL=

# --- supabase: project URL and SERVICE ROLE key (server only, never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
